100 REM ********************
110 REM *   TEST GR 8      *
120 PI=3.141592
130 R=0:S=20:C=2:PH=137.508
140 GRAPHICS 8+16
150 SETCOLOR 1,1,14:SETCOLOR 2,0,2:COLOR 1
160 FOR N=0 TO 2100
170   X2=X
180   Y2=Y
182   R=SQR(N)*C
185   TH=(N*PH)*PI/180
190   X=R*SIN(TH)+160
200   Y=96-R*COS(TH)
270     IF X>0 AND X<319 AND Y>0 AND Y<191 AND X2>0
275         PLOT X,Y
280     ENDIF
290 NEXT N
300 CONSOL=PEEK($D01F)
310 IF CONSOL<>6 THEN GOTO 300
