100 REM ********************
110 REM *   TEST GR 8      *
120 PI=3.141592
130 R=90:S=20
140 GRAPHICS 8+16
150 SETCOLOR 1,1,14:SETCOLOR 2,0,2:COLOR 1
160 FOR I=I*S TO 360 STEP S
170   X=R*SIN(TH)
180   Y=R*COS(TH)
190   TH=I*PI/180
195   FOR J=0 TO 360 STEP S
200     PH=J*PI/180
210     X2=R*SIN(PH)
220     Y2=R*COS(PH)
250     XS=X+160
260     YS=96-Y
270     IF XS>0 AND XS<319 AND YS>0 AND YS<191
275         PLOT X2+160,96-Y2:DRAWTO XS,YS
280     ENDIF
285   NEXT J
290 NEXT I
300 CONSOL=PEEK($D01F)
310 IF CONSOL<>6 THEN GOTO 300
